FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.18 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project --no-default-groups --group ui
ENV PATH="/srv/.venv/bin:$PATH" PYTHONPATH=/srv/app
COPY app/contracts app/contracts
COPY app/services/__init__.py app/services/__init__.py
COPY app/services/ui app/services/ui
COPY scripts scripts
CMD ["python", "/srv/scripts/scaffold_ui.py"]
