FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /srv
COPY docker/scaffold/pyproject.toml docker/scaffold/uv.lock ./
RUN uv sync --frozen --no-install-project
ENV PATH="/srv/.venv/bin:$PATH" PYTHONPATH=/srv/app
COPY app/contracts app/contracts
COPY app/services/__init__.py app/services/__init__.py
COPY app/services/rag app/services/rag
COPY scripts scripts
CMD ["python", "/srv/scripts/scaffold_rag.py"]
