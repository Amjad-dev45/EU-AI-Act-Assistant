# Copy this file to .env and fill in your team OpenAI API key.
OPENAI_API_KEY=

# Run from the repo root; override if your corpus lives elsewhere.
RAG_DATA_DIR=data
# Optional overrides; defaults resolve relative to this repository.
# RAG_METRICS_DB=logs/requests.sqlite3
# RAG_PRICING_FILE=config/pricing.json

# Local reranking: retrieve 20 candidates, keep the requested top k (default 5).
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATES=20

# Optional sharing. MCP is primary; bot is the explicit setup fallback.
SLACK_TRANSPORT=mcp
SLACK_CHANNEL_ID=
# User OAuth token for an internal Slack app enabled for MCP, with chat:write.
SLACK_MCP_TOKEN=
# Used only when SLACK_TRANSPORT=bot (bot must be in the channel).
SLACK_BOT_TOKEN=
