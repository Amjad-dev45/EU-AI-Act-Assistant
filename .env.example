# Read by local scripts and the Agent/RAG containers. Keep the key in .env only.
OPENAI_API_KEY=

# Optional Microsoft Teams incoming webhook / Power Automate workflow URL.
# Only the Agent receives this secret; messages require a UI button click.
web_hook=

# Optional Docker settings. Existing .env files do not need these defaults added.
SCAFFOLD_UI_PORT=7860
UI_TIMEOUT_S=300
RAG_TIMEOUT_S=90

# Provisional relevance cutoff; scores are not probabilities.
RAG_MIN_RERANK_SCORE=-5.0

# Match your host UID/GID if different, so new cache/log files remain writable.
LOCAL_UID=1000
LOCAL_GID=1000
